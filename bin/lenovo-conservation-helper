#!/usr/bin/env python3
"""Standalone executable helper for Lenovo Conservation privileged sysfs writes."""

import os
import sys

# Ensure project root is in sys.path when running from source checkout
project_root = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
if project_root not in sys.path:
    sys.path.insert(0, project_root)

from lenovo_conservation.privileged_helper import main_helper

if __name__ == "__main__":
    sys.exit(main_helper())
