#!/usr/bin/env python3
"""Daemon entry point for Lenovo Conservation background service."""

import os
import sys

# Ensure project root or install location is in sys.path
search_paths = [
    os.path.abspath(os.path.join(os.path.dirname(__file__), "..")),
    "/opt/lenovo-conservation",
    "/usr/local/share/lenovo-conservation",
    "/usr/share/lenovo-conservation",
    os.path.expanduser("~/.local/share/lenovo-conservation"),
]
for p in search_paths:
    if os.path.isdir(p) and p not in sys.path:
        sys.path.insert(0, p)

from lenovo_conservation.service import main_service

if __name__ == "__main__":
    sys.exit(main_service())
